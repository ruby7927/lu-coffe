generator client {
  provider        = "prisma-client-js"
  output          = "../app/generated/prisma/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  origin      String
  process     String
  roastLevel  String
  flavorNotes String[]
  description String
  price100g       Int  @default(0)
  price200g       Int  @default(0)
  priceRegular    Int  @default(0)
  priceCommunity  Int  @default(0)
  imageUrl    String?
  isActive    Boolean  @default(true)
  isSeasonal  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  customerName   String
  phone          String
  email          String?
  address        String
  shippingMethod String
  paymentMethod  String
  status         OrderStatus @default(PENDING)
  subtotal       Int
  shippingFee    Int
  total          Int
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  size      String
  quantity  Int
  price     Int
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  category    String
  excerpt     String
  content     String
  coverImage  String?
  isPublished Boolean   @default(false)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Setting {
  key   String @id
  value String
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}
